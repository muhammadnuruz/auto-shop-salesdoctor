# Copy to .env and fill in. Never commit real secrets.

# --- App ---
# ENV has NO permissive default: when unset the app runs as `production` and enforces strict
# validation (strong APP_SECRET_KEY, https ALLOWED_ORIGINS, SD credentials, Secure cookies).
ENV=local                # local | test | staging | production  (use `local` only on a dev machine)
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- Postgres (used by the db container and to build DATABASE_URL) ---
POSTGRES_USER=autoshop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autoshop
DATABASE_URL=postgresql+asyncpg://autoshop:change-me@db:5432/autoshop

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Sales Doctor API ---
SD_BASE_URL=https://your-server.salesdoc.io/api/v2/
SD_LOGIN=
SD_PASSWORD=
# SD_FILIAL_ID=           # optional; omit when getFilials returns empty
SD_TIMEOUT=30            # seconds, per HTTP request
SD_MAX_RETRIES=3         # retries on transport errors / 5xx / timeouts
# The SD server answers 403 to the default python/httpx User-Agent.
SD_USER_AGENT=Mozilla/5.0 (compatible; AutoShop/1.0)
SD_LOGIN_TIMEOUT=15      # seconds, overall cap for one login attempt (never retried)
SD_LOCK_TIMEOUT=30       # seconds, login lock TTL; must be >= SD_LOGIN_TIMEOUT + 5
# SD_LOGIN / SD_PASSWORD are required when ENV is not local/test.

# --- Security / auth (Phase 3) ---
# Required outside local/test: >= 32 random chars (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
APP_SECRET_KEY=
# TOTP_ENC_KEY=            # optional dedicated Fernet key; default is derived from APP_SECRET_KEY
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated, no '*', https required outside local/test
TRUSTED_PROXIES=         # comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For
# COOKIE_SECURE=false    # only honoured for ENV local/test; Secure is always on elsewhere
# RL_*  rate limits, ADMIN_MAX_FAILED_LOGINS / ADMIN_LOCKOUT_MINUTES (lock is per username+IP),
# SESSION_PURGE_AFTER_DAYS=7, AUDIT_RETENTION_DAYS=365 (daily purge job in the worker).
