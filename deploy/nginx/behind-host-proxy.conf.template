# Container nginx when TLS is terminated by a host-level nginx (shared server).
# The container port is bound to 127.0.0.1 only, so the host proxy is the only client and
# its X-Real-IP (= the real client address) is trusted. See docs/DEPLOY.md, "Host nginx".
resolver 127.0.0.11 valid=10s ipv6=off;

limit_req_zone $http_x_real_ip zone=api_ip:10m rate=30r/s;

server {
  listen 80;
  server_name ${DOMAIN};
  server_tokens off;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 512;
  gzip_vary on;
  gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

  include /etc/nginx/snippets/security-headers.conf;

  location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

  location /api/ {
    limit_req zone=api_ip burst=60 nodelay;
    limit_req_status 429;
    set $upstream http://api:8000;
    proxy_pass $upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $http_x_real_ip;
    # overwrite (not append): the host proxy's view of the client address is the only truth
    proxy_set_header X-Forwarded-For $http_x_real_ip;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
    client_max_body_size 2m;
  }

  location = /health {
    set $upstream http://api:8000;
    proxy_pass $upstream;
  }

  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
