# Production .env — copy to .env on the server, fill in, chmod 600. Never commit it.
# All values marked REQUIRED are validated at startup (the app refuses to start without them).

# --- App ---
ENV=production
LOG_LEVEL=INFO
APP_RELEASE=                       # optional, e.g. git sha (shown in Sentry / error reports)
DOMAIN=shop.example.uz             # REQUIRED: public host name (nginx + certificate)
LETSENCRYPT_EMAIL=admin@example.uz # REQUIRED for deploy/init-letsencrypt.sh
ALLOWED_ORIGINS=https://shop.example.uz   # REQUIRED: https origin(s) of the SPA
TRUSTED_PROXIES=172.30.0.0/24      # the compose network (nginx is the only proxy)
WEB_CONCURRENCY=4                  # API processes (~ number of CPU cores)
DB_POOL_SIZE=5                     # per process: 4 x (5+5) + worker 10 < max_connections 100
DB_MAX_OVERFLOW=5

# --- Secrets (REQUIRED) ---
# python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOTP_ENC_KEY=

# --- Postgres ---
POSTGRES_USER=autoshop
POSTGRES_PASSWORD=                 # REQUIRED: long random value
POSTGRES_DB=autoshop
DATABASE_URL=postgresql+asyncpg://autoshop:CHANGE_ME_SAME_PASSWORD@db:5432/autoshop

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Sales Doctor (REQUIRED) ---
SD_BASE_URL=https://buxdiler.salesdoc.io/api/v2/
SD_LOGIN=
SD_PASSWORD=
SD_USER_AGENT=Mozilla/5.0 (compatible; AutoShop/1.0)

# --- Backups (daily pg_dump + restore test, see deploy/backup) ---
BACKUP_DIR=./backups               # mount an off-server/encrypted location here if possible
BACKUP_HOUR=2                      # Asia/Tashkent
BACKUP_RETENTION_DAYS=14

# --- Error tracking (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
